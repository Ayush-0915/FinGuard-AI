# ==============================================================================
# FinGuard AI — Environment Configuration Template (.env.example)
# Copy this file to .env for local development. Never commit real secret keys.
# ==============================================================================

# Supabase Database Credentials (Obtain from Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key-placeholder

# Server Network Configuration (Render automatically sets PORT in production)
PORT=8000
FINGUARD_PORT=8000

# CORS Security Origin Configuration
# Specify the exact origin of your deployed Render frontend web app (no wildcard *)
FRONTEND_URL=https://finguard-ai-web.onrender.com
CORS_ORIGINS=https://finguard-ai-web.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Temporary / Generated PDF Reports Directory Path
FINGUARD_REPORTS_DIR=/tmp/finguard-reports
